<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
        Title="TPW Etap 1" Height="650" Width="600">

    <Window.DataContext>
        <vm:ViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Text="Ilość kul:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBox x:Name="BallCountBox"
                     Width="60"
                     Height="30"
                     Text="10"
                     VerticalContentAlignment="Center"
                     Margin="0 0 20 0"/>

            <Button Content="Start"
                    Width="100"
                    Height="30"
                    Click="Start_Click"/>
        </StackPanel>

        <Canvas x:Name="BallCanvas"
                Grid.Row="1"
                Width="500"
                Height="500"
                Background="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <Rectangle Width="500"
                       Height="500"
                       Stroke="Black"
                       StrokeThickness="3"
                       Fill="LightGray" Canvas.Left="41" Canvas.Top="38"/>

            <ItemsControl ItemsSource="{Binding Balls}" Canvas.Left="41" Canvas.Top="38">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="500" Height="500"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="{Binding Radius}"
                                 Height="{Binding Radius}"
                                 Fill="{Binding Color}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Canvas>

    </Grid>
</Window>
